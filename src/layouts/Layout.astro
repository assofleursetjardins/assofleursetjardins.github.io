---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Inscription from "../components/Inscription.astro";
import Localisation from "../components/Localisation.astro";
import Tarifs from "../components/Tarifs.astro";
import "../styles/global.css";
import "@fontsource/abril-fatface";

const {
  metaTitle = "",
  metaDescription = "",
  pageTitle = "",
  pageDescription = "",
} = Astro.props;

const asideComponents = Astro.props.frontmatter?.asideComponents || [];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{metaTitle || "Salon fleurs & Jardins"}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
  </head>
  <body class="bg-background text-foreground">
    <Header />
    <div class="grid md:grid-cols-12 max-w-7xl mx-auto gap-8">
      <main class="md:col-span-8">
        <slot />
      </main>
      <aside class="md:col-span-4">
        {
          asideComponents.map((component: string) => {
            switch (component) {
              case "Inscription":
                return <Inscription />;
              case "Localisation":
                return <Localisation />;
              case "Tarifs":
                return <Tarifs />;
              default:
                return null;
            }
          })
        }
      </aside>
    </div>
    <Footer />
  </body>
</html>
