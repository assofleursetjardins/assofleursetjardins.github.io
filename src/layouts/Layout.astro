---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Inscription from '../components/Inscription.astro';
import Localisation from '../components/Localisation.astro';
import Prices from '../components/Prices.astro';
import InfoPratiques from '../components/InfoPratiques.astro';
import '../styles/global.css';
import '@fontsource/abril-fatface';
import { Image, imageConfig } from 'astro:assets';

const {
  metaTitle = '',
  metaDescription = '',
  pageTitle = '',
  pageDescription = '',
  frontmatter = {},
} = Astro.props;

const image = frontmatter.image || '';
const title = frontmatter.imgtitle || '';

const imageBanner = frontmatter.imageBanner || '';
const titleBanner = frontmatter.titleBanner || '';

const asideComponents = Astro.props.frontmatter?.asideComponents || [];
const banner = Astro.props.frontmatter?.banner || [];

// Get the current URL
const currentUrl = Astro.url.pathname;
const isHomePage = currentUrl === '/';
console.log('isHomePage', isHomePage);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{metaTitle || 'Salon fleurs & Jardins'}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
  </head>
  <body class="bg-background text-foreground">
    <Header isHomePage={isHomePage} />

    {
      banner === 'afficher' && (
        <img
          src={frontmatter.imageBanner}
          alt={frontmatter.titleBanner}
          class=""
        />
      )
    }
    <div
      class="grid md:grid-cols-12 max-w-7xl mx-auto gap-8 relative lg:top-65 top-50"
    >
      <main class="md:col-span-8 sm:mx-7 max-sm:mx-7">
        <slot />
      </main>
      <aside class="md:col-span-4 sm:mx-7">
        {
          asideComponents.map((components: string) => {
            switch (components) {
              case 'Inscription':
                return <Inscription />;
              case 'Localisation':
                return <Localisation />;
              case 'Prices':
                return <Prices />;
              case 'InfoPratiques':
                return <InfoPratiques />;
              case 'image':
                return (
                  <img src={frontmatter.image} alt={frontmatter.imgtitle} />
                );

              default:
                return null;
            }
          })
        }
      </aside>
    </div>
    <Footer />
  </body>
</html>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accentsMap = new Map([
      ['A', 'A'],
      ['Á', 'A'],
      ['À', 'A'],
      ['Â', 'A'],
      ['Ä', 'A'],
      ['Ã', 'A'],
      ['Å', 'A'],
      ['a', 'a'],
      ['á', 'a'],
      ['à', 'a'],
      ['â', 'a'],
      ['ä', 'a'],
      ['ã', 'a'],
      ['å', 'a'],
      ['C', 'C'],
      ['Ç', 'C'],
      ['c', 'c'],
      ['ç', 'c'],
      ['E', 'E'],
      ['É', 'E'],
      ['È', 'E'],
      ['Ê', 'E'],
      ['Ë', 'E'],
      ['e', 'e'],
      ['é', 'e'],
      ['è', 'e'],
      ['ê', 'e'],
      ['ë', 'e'],
      ['I', 'I'],
      ['Í', 'I'],
      ['Ì', 'I'],
      ['Î', 'I'],
      ['Ï', 'I'],
      ['i', 'i'],
      ['í', 'i'],
      ['ì', 'i'],
      ['î', 'i'],
      ['ï', 'i'],
      ['N', 'N'],
      ['Ñ', 'N'],
      ['n', 'n'],
      ['ñ', 'n'],
      ['O', 'O'],
      ['Ó', 'O'],
