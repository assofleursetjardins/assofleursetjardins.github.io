      ['ú', 'u'],
      ['ù', 'u'],
      ['û', 'u'],
      ['ü', 'u'],
      ['Y', 'Y'],
      ['Ý', 'Y'],
      ['Ÿ', 'Y'],
      ['y', 'y'],
      ['ý', 'y'],
      ['ÿ', 'y'],
    ]);

    const normalizeText = (text: string) => {
      return text
        .split('')
        .map((char) => accentsMap.get(char) || char)
        .join('');
    };

    document.querySelectorAll('h2').forEach((h2) => {
      if (!h2.textContent) return;
      const id = normalizeText(
        h2.textContent.toLowerCase().replace(/\s+/g, '-')
      );
      h2.id = id;
    });
  });
</script>
