---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Inscription from '../components/Inscription.astro';
import Localisation from '../components/Localisation.astro';
import Prices from '../components/Prices.astro';
import InfoPratiques from '../components/InfoPratiques.astro';
import Banner from '../components/Banner.astro';
import '../styles/global.css';
import '@fontsource/abril-fatface';
import { Image, imageConfig } from 'astro:assets';

const {
  metaTitle = '',
  metaDescription = '',
  pageTitle = '',
  pageDescription = '',
  frontmatter = {},
} = Astro.props;

const image = frontmatter.image || '';
const title = frontmatter.imgtitle || '';

const asideComponents = Astro.props.frontmatter?.asideComponents || [];
const hasBanner = frontmatter?.hasBanner || false;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{metaTitle || 'Salon Fleurs & Jardins'}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
  </head>
  <body class="bg-background text-foreground">
    <Header />

    {
      hasBanner && (
        <div class="w-full">
          <Banner />
        </div>
      )
    }

    <div class="mr-6 ml-6 grid max-w-7xl gap-8 md:mx-auto md:grid-cols-12">
      <main class="md:col-span-8">
        <slot />
      </main>
      <aside class="md:col-span-4">
        {
          asideComponents.map((components: string) => {
            switch (components) {
              case 'Inscription':
                return <Inscription />;
              case 'Localisation':
                return <Localisation />;
              case 'Prices':
                return <Prices />;
              case 'InfoPratiques':
                return <InfoPratiques />;
              case 'image':
                return (
                  <img src={frontmatter.image} alt={frontmatter.imgtitle} />
                );
              default:
                return null;
            }
          })
        }
      </aside>
    </div>
    <Footer />
  </body>
</html>
