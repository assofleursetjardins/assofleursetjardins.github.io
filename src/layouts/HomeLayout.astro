---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Inscription from '../components/Inscription.astro';
import Localisation from '../components/Localisation.astro';
import Card from '../components/Card.astro';
import Button from '../components/ui/button.astro';
import Date from '../components/Date.astro';
import '../styles/global.css';
import '@fontsource/abril-fatface';
import { Image, imageConfig } from 'astro:assets';
import { Icon } from 'astro-icon/components';

const {
  metaTitle = '',
  metaDescription = '',
  pageTitle = '',
  pageDescription = '',
  frontmatter = {},
} = Astro.props;

const image = frontmatter.image || '';
const title = frontmatter.imgtitle || '';

const asideComponents = Astro.props.frontmatter?.asideComponents || [];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{metaTitle || 'Salon fleurs & Jardins'}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
  </head>
  <body class="bg-background text-foreground">
    <Header />
    <main id="main-content" class="px-6">
      <section class="mx-auto grid max-w-7xl gap-8 md:grid-cols-12">
        <div class="md:col-span-8">
          <Date />
          <slot />
        </div>
        <img
          class="md:col-span-4"
          src={frontmatter.image}
          alt={frontmatter.imgtitle}
        />
      </section>

      <section
        class="mx-auto my-16 grid max-w-7xl gap-8 md:my-32 md:grid-cols-3"
      >
        <Card title="Programme" subtitle="Riche en découvertes">
          <p
            class="text-foreground mt-4.5 mb-7 text-lg font-normal text-pretty"
          >
            Actualités, animations, ateliers, conférences… Découvrez un
            programme riche et varié, jour après jour, pour tous les publics et
            tous les âges !
          </p>
          <Button variant="ghost" href="/a-propos#programme">
            <span>Consulter le programme</span>
            <Icon name="arrow-right" class="text-primary h-4 w-4" />
          </Button>
        </Card>

        <Card title="Localisation" subtitle="Une situation géographique idéale">
          <p
            class="text-foreground mt-4.5 mb-7 text-lg font-normal text-pretty"
          >
            À moins de 100 km de Paris, à 20 km de Rouen et 120 km de Caen via
            l’A13, le village du Vaudreuil vous accueille dans un cadre normand
            charmant, avec son golf 18 trous.
          </p>
          <Button variant="ghost" href="/infos-pratiques">
            <span>Voir les infos pratiques</span>
            <Icon name="arrow-right" class="text-primary h-4 w-4" />
          </Button>
        </Card>

        <Card title="Exposants" subtitle="De nombreux professionnels">
          <p
            class="text-foreground mt-4.5 mb-7 text-lg font-normal text-pretty"
          >
            Comme chaque année, nos exposants fidèles seront présents pour
            partager leur passion et exposer leur savoir-faire dans les rues du
            village.
          </p>
          <Button variant="ghost" href="/exposants">
            <span>Découvrir les exposants</span>
            <Icon name="arrow-right" class="text-primary h-4 w-4" />
          </Button>
        </Card>
      </section>

      <section class="mx-auto mt-16 grid max-w-4xl gap-8 md:grid-cols-1">
        <Inscription class="p-6 md:p-16" />
      </section>
    </main>
    <Footer />
  </body>
</html>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accentsMap = new Map([
      ['A', 'A'],
      ['Á', 'A'],
      ['À', 'A'],
      ['Â', 'A'],
      ['Ä', 'A'],
      ['Ã', 'A'],
      ['Å', 'A'],
      ['a', 'a'],
      ['á', 'a'],
      ['à', 'a'],
      ['â', 'a'],
      ['ä', 'a'],
      ['ã', 'a'],
      ['å', 'a'],
      ['C', 'C'],
      ['Ç', 'C'],
      ['c', 'c'],
      ['ç', 'c'],
      ['E', 'E'],
      ['É', 'E'],
      ['È', 'E'],
      ['Ê', 'E'],
      ['Ë', 'E'],
      ['e', 'e'],
      ['é', 'e'],
      ['è', 'e'],
      ['ê', 'e'],
      ['ë', 'e'],
      ['I', 'I'],
      ['Í', 'I'],
      ['Ì', 'I'],
      ['Î', 'I'],
      ['Ï', 'I'],
      ['i', 'i'],
      ['í', 'i'],
      ['ì', 'i'],
      ['î', 'i'],
      ['ï', 'i'],
      ['N', 'N'],
      ['Ñ', 'N'],
      ['n', 'n'],
      ['ñ', 'n'],
      ['O', 'O'],
      ['Ó', 'O'],
      ['Ò', 'O'],
      ['Ô', 'O'],
      ['Ö', 'O'],
      ['Õ', 'O'],
      ['Ø', 'O'],
      ['o', 'o'],
      ['ó', 'o'],
      ['ò', 'o'],
      ['ô', 'o'],
      ['ö', 'o'],
      ['õ', 'o'],
      ['ø', 'o'],
      ['U', 'U'],
      ['Ú', 'U'],
      ['Ù', 'U'],
      ['Û', 'U'],
      ['Ü', 'U'],
      ['u', 'u'],
      ['ú', 'u'],
      ['ù', 'u'],
      ['û', 'u'],
      ['ü', 'u'],
      ['Y', 'Y'],
      ['Ý', 'Y'],
      ['Ÿ', 'Y'],
      ['y', 'y'],
      ['ý', 'y'],
      ['ÿ', 'y'],
    ]);

    const normalizeText = (text: string) => {
      return text
        .split('')
        .map((char) => accentsMap.get(char) || char)
        .join('');
    };

    document.querySelectorAll('h2').forEach((h2) => {
      if (!h2.textContent) return;
      const id = normalizeText(
        h2.textContent.toLowerCase().replace(/\s+/g, '-'),
      );
      h2.id = id;
    });
  });
</script>
