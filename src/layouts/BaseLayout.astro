---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Inscription from '../components/Inscription.astro';
import Localisation from '../components/Localisation.astro';
import InfoPratiques from '../components/InfoPratiques.astro';
import ExhibitorList from '../components/ExhibitorList.astro';
import '../styles/global.css';
import '@fontsource/abril-fatface';

const {
  metaTitle: propsMetaTitle = '',
  metaDescription: propsMetaDescription = '',
  frontmatter = {},
} = Astro.props;

// Récupération des meta depuis props ou frontmatter (pour gérer tous les cas)
const metaTitle = propsMetaTitle || frontmatter.metaTitle || '';
const metaDescription =
  propsMetaDescription || frontmatter.metaDescription || '';

const asideComponents = Astro.props.frontmatter?.asideComponents || [];
const bottomComponents = Astro.props.frontmatter?.bottomComponents || [];

const components: Record<string, any> = {
  Inscription,
  Localisation,
  InfoPratiques,
  ExhibitorList,
};

console.log(bottomComponents);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{metaTitle || 'Salon fleurs & Jardins'}</title>
    <meta name="description" content={metaDescription} />
  </head>
  <body class="bg-background text-foreground">
    <Header />
    <div
      class="mx-auto grid max-w-7xl space-y-8 px-6 lg:grid-cols-[2fr_1fr] lg:gap-16 lg:space-y-0"
    >
      <main id="main-content">
        <article>
          <slot />
        </article>
        {
          bottomComponents.map((componentObj: { component: string }) => {
            const Component = components[componentObj.component];
            return Component ? <Component /> : null;
          })
        }
      </main>
      <aside class="space-y-8">
        {
          asideComponents.map((componentObj: { component: string }) => {
            const Component = components[componentObj.component];
            return Component ? <Component /> : null;
          })
        }
      </aside>
    </div>
    <Footer />
  </body>
</html>

<script>
