---
import siteConfig from '../data/program.json';
const { Opening, Closing, Date } = siteConfig.salon.schedule;
---

<div>
  <h2 class="font-heading text-4xl mb-10 text-foreground">Le programme</h2>
  <p>Retrouvez le programme jour par jour…</p>

  {Date && <h3>{Date}</h3>}
  <ul class="font-base">
    {
      Opening && (
        <li class="text-2xl mb-6 mt-5">
          {' '}
          <strong>Ouverture du marché floral</strong> : {Opening}
        </li>
      )
    }
    {
      Closing && (
        <li class="text-2xl mb-7">
          {' '}
          <strong>Fermeture</strong> : {Closing}
        </li>
      )
    }
  </ul>
</div>
