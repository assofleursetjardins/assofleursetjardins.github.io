---
import NavigationLink from './NavigationLink.astro';
import siteConfig from '../data/navigations.json';

const { id } = Astro.props;
type LinkType = {
  url: string;
  label: string;
  description: string;
};

const { primary } = siteConfig.navigations;
---

<nav class="absolute inset-x-4 top-full z-2 lg:static">
  <div
    id={id}
    class="top-10 hidden flex-col gap-10 rounded-2xl border border-gray-300 bg-neutral-50 px-4 py-8 text-center md:p-0 lg:flex lg:flex-row lg:gap-10 lg:border-none"
  >
    {
      primary.map((link) => (
        <NavigationLink
          url={link.url}
          title={link.label}
          description={link.description}
        />
      ))
    }
  </div>
</nav>
