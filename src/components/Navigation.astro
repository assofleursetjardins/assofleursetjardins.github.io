---
import Logo from "./Logo.astro";
import NavigationLink from "./NavigationLink.astro";
import { siteConfig } from "../site-config";
const { id } = Astro.props;
---

<nav class="absolute inset-x-4 lg:static top-full z-2">
  <div
    id={id}
    class="hidden flex-col lg:flex lg:flex-row top-10 lg:gap-10 text-center gap-10 bg-neutral-50 lg:border-none border border-gray-300 rounded-2xl"
  >
    {
      siteConfig.mainMenu.map((link) => (
        <NavigationLink
          url={link.url}
          title={link.title}
          description={link.description}
        />
      ))
    }
  </div>
</nav>
