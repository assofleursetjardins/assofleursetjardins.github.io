---
import NavigationLink from './NavigationLink.astro';
import siteConfig from '../data/navigations.json';

const { id } = Astro.props;
type LinkType = {
  url: string;
  label: string;
  description: string;
};

const { primary } = siteConfig.navigations;
---

<nav class="absolute inset-x-4 lg:static top-full z-2 lg:w-auto w-screen left-0">
  <div
    id={id}
    class="hidden max-h-auto px-4 py-8 flex-col lg:flex lg:flex-row top-10 lg:gap-20 text-center gap-10 bg-primary lg:bg-background lg:border-none border border-gray-300 "
  >
    {
      primary.map((link) => (
        <NavigationLink
          url={link.url}
          title={link.label}
          description={link.description}
        />
      ))
    }
  </div>
</nav>
