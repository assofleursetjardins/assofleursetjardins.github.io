---
import NavigationLink from "./NavigationLink.astro";
import { SiteConfig } from "../site-config";

const { id } = Astro.props;
---

<nav class="flex">
  <div id={id} class="hidden md:flex text-center justify-items-end gap-10">
    {
      SiteConfig.mainMenu.map((link) => (
        <NavigationLink
          url={link.url}
          title={link.title}
          description={link.description}
        />
      ))
    }
  </div>
</nav>
