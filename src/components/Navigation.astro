---
import Logo from "./Logo.astro";
import NavigationLink from "./NavigationLink.astro";
import { SiteConfig } from "../site-config";
import Burger from "./Burger.astro";
---

<nav class="flex">
  <div
    id="nav-container"
    class="hidden md:flex text-center justify-items-end gap-10"
  >
    {
      SiteConfig.mainMenu.map((link) => (
        <NavigationLink
          url={link.url}
          title={link.title}
          description={link.description}
        />
      ))
    }
  </div>
</nav>
