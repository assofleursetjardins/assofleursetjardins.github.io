---
import TopBanner from './TopBanner.astro';
import Burger from './ui/Burger.astro';
import Navigation from './Navigation.astro';
import Logo from './Logo.astro';
---

<header>
  <div class="z-1000 fixed top-0 w-screen">
    <TopBanner />
  </div>
  <div
    id="main-header"
    class="flex items-center justify-between px-7 py-4 max-w-7xl mx-auto bg-background fixed top-15 w-screen z-900 transition-transform duration-850"
  >
    <a class="block w-[200px] lg:w-[300px]" href="/">
      <Logo />
    </a>
    <Navigation id="main-nav-container" />
    <Burger id="main-burger-menu" />
  </div>

  <script>
    const burgerMenu = document.querySelector('#main-burger-menu');
    const navContainer = document.querySelector('#main-nav-container');

    if (burgerMenu && navContainer) {
      burgerMenu.addEventListener('click', () => {
        navContainer.classList.toggle('flex');
        navContainer.classList.toggle('hidden');
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      let lastScrollY = window.scrollY;
      const header = document.querySelector('#main-header');

      if (!header) return;

      document.addEventListener('scroll', () => {
        if (window.scrollY > lastScrollY) {
          // Cache le header si on défile vers le bas
          header.classList.add('-translate-y-65');
        } else {
          // Affiche le header si on défile vers le haut
          header.classList.remove('-translate-y-65');
        }

        lastScrollY = window.scrollY;
      });
    });
  </script>
</header>
