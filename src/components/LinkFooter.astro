---
import siteConfig from "../data/navigations.json";
import "../styles/global.css";

type LinkFooterType = {
    url: string;
    label: string;
};

const { footer } = siteConfig.navigations;
---

<div class="px-3 mb-11 box-border w-full">
    <h4 class="text-foreground-contrast text-base font-bold my-4">
        Navigation
    </h4>
    {
        footer &&
            footer.map((item: LinkFooterType) => (
                <a
                    class="block cursor-pointer underline hover:text-foreground-accent text-foreground text-base leading-7"
                    href={item.url}
                >
                    {item.label}
                </a>
            ))
    }
</div>
