---
import siteConfig from '../data/navigations.json';
import '../styles/global.css';
import ExternalLink from './ExternalLink.astro';

type LinkFooterType = {
  url: string;
  label: string;
};

const { footer } = siteConfig;
---

<div class="mb-11 box-border w-full px-3">
  <p class="text-foreground-contrast my-4 text-lg font-bold">Navigation</p>
  {
    footer &&
      footer.map((item: LinkFooterType) => (
        <ExternalLink
          href={item.url}
          class="hover:text-foreground-accent text-foreground block cursor-pointer text-base leading-7 underline"
        >
          {item.label}
        </ExternalLink>
      ))
  }
</div>
