---
import siteConfig from '../data/editonSalon.json';
const { ticketPrice, parkingPrice } = siteConfig.pricing;
---

<div>
  <h2 class="font-heading text-foreground mb-10 text-4xl">Tarifs</h2>
  <ul class="font-base">
    {
      ticketPrice && (
        <li class="mt-5 mb-6 text-2xl">
          {' '}
          <strong>Entrée</strong> : {ticketPrice}
        </li>
      )
    }
    {
      parkingPrice && (
        <li class="mb-7 text-2xl">
          {' '}
          <strong>Parking</strong> : {parkingPrice}
        </li>
      )
    }
  </ul>
</div>
