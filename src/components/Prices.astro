---
import siteConfig from '../data/editonSalon.json';
const { ticketPrice, parkingPrice } = siteConfig.salon.pricing;
---

<div>
  <h2 class="font-heading text-4xl mb-10 text-foreground">Tarifs</h2>
  <ul class="font-base">
    {
      ticketPrice && (
        <li class="text-2xl mb-6 mt-5">
          {' '}
          <strong>Entrée</strong> : {ticketPrice}
        </li>
      )
    }
    {
      parkingPrice && (
        <li class="text-2xl mb-7">
          {' '}
          <strong>Parking</strong> : {parkingPrice}
        </li>
      )
    }
  </ul>
</div>
