---
import Button from "./ui/button.astro";
import siteConfig from "../data/editonSalon.json";
import siteConfigInfo from "../data/infoGeneral.json";

const editionYear = siteConfig.salon.edition;
const conditateUrl = siteConfigInfo.site.email.contact;
---

<aside class="p-6 mb-12 bg-secondary text-secondary-foreground max-w-80 h-auto">
    <h2 class="font-heading text-4xl mb-5 leading-10 font-bold">Inscription</h2>
    <p
        class="has-separator mb-3 uppercase leading-5 font-medium text-base text-neutral-50"
    >
        Vous êtes exposant ? Il est encore temps de candidater
    </p>

    <p class="mb-7 mt-4.5 text-lg font-normal">
        Vous êtes un professionnel et vous souhaitez venir participer au Marché
        floral {editionYear}, envoyez nous votre demande de candidature.
        Celle-ci sera étudiée par le comité organisteur et une réponse vous sera
        adressée dans les meilleurs délais.
    </p>

    <Button
        href={`mailto:${conditateUrl}`}
        class="bg-neutral-50 text-secondary hover:bg-neutral-50/90"
        >Candidater <br />maintenant</Button
    >
</aside>

<style>
    .has-separator {
        --separator-color: #fff;
        --separator-size: 3px;
    }
</style>
