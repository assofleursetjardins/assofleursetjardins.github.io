---
import Button from './ui/button.astro';
import siteConfig from '../data/editonSalon.json';
import siteConfigInfo from '../data/infoGeneral.json';
import { cn } from '../lib/utils';

const editionYear = siteConfig.editionRegistration.registrationEditionDate;
const editionShowCallout =
  siteConfig.editionRegistration.registrationShowCallout;
const conditateUrl = siteConfigInfo.contact.email.general;

const { class: className } = Astro.props;
---

{
  editionShowCallout && (
    <aside
      class={cn(
        'border-primary bg-primary/10 mt-0 h-auto rounded border-4 p-6',
        className,
      )}
    >
      <h2 class="font-heading mb-0 py-4 text-3xl leading-10 font-bold">
        Vous êtes exposant&nbsp;?
      </h2>
      <p class="has-separator font-base text-sm text-balance uppercase">
        Il est encore temps de candidater pour le prochaine édition du Marché
        Floral
      </p>

      <p class="mt-4.5 mb-7 text-lg font-normal">
        Vous êtes un professionnel et vous souhaitez venir participer au Marché
        floral {editionYear}, envoyez nous votre demande de candidature.
        Celle-ci sera étudiée par le comité organisteur et une réponse vous sera
        adressée dans les meilleurs délais.
      </p>

      <Button href={`mailto:${conditateUrl}`} variant="primary">
        Candidater maintenant
      </Button>
    </aside>
  )
}
