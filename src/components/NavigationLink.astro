---
const { url, title, description } = Astro.props;

const isActive = Astro.url.pathname === url;
---

<a
  href={url}
  class=`relative nav-links group flex flex-col text-center ${isActive ? 'is-active' : ''}`
>
  <span
    class=`text-2xl font-semibold gap-10 font-heading lg:text-foreground text-background lg:hover:text-primary/80 hover:text-foreground/80 ${isActive ? 'text-background lg:text-primary' : ''}`
    >{title}</span
  >
  <span class="text-sm font-light lg:text-foreground text-background"
    >{description}</span
  >
</a>

<style>
  @media (width >= 64rem) {
    a.is-active::after {
      content: '';
      display: block;
      width: 0.5rem;
      height: 0.5rem;
      background-color: var(--color-primary);
      position: absolute;
      bottom: -1rem;
      left: 50%;
      transform: translateX(-50%);
      border-radius: 50%;
    }
  }
  @media (width < 64rem) {
    a.is-active::after {
      content: '';
      display: block;
      width: 0.5rem;
      height: 0.5rem;
      background-color: var(--color-background);
      position: absolute;
      bottom: -1rem;
      left: 50%;
      transform: translateX(-50%);
      border-radius: 50%;
    }
  }
</style>
