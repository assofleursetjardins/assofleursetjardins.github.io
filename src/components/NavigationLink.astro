---
const { url, title, description } = Astro.props;

// Normaliser les URLs en retirant les trailing slashes et en s'assurant qu'elles commencent par /
const normalizeUrl = (path: string) => {
  return path.replace(/\/$/, '').replace(/^\/?/, '/');
};

const currentPath = normalizeUrl(Astro.url.pathname);
const targetPath = normalizeUrl(url);

// Vérifier si le chemin actuel commence par le chemin cible
const isActive =
  currentPath.startsWith(targetPath) || targetPath.startsWith(currentPath);
---

<a
  href={url}
  class={`relative nav-links group flex flex-col text-center ${isActive ? 'is-active' : ''}`}
  aria-current={isActive ? 'page' : undefined}
  role="menuitem"
  aria-label={`${title} - ${description}`}
>
  <span
    class={`text-2xl font-extrabold gap-10 ${isActive ? 'text-primary' : ''}`}
    aria-hidden="true">{title}</span
  >
  <span class="text-sm font-light text-gray-500" aria-hidden="true"
    >{description}</span
  >
</a>

<style>
  a.is-active::after {
    content: '';
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    background-color: var(--color-primary);
    position: absolute;
    bottom: -1rem;
    left: 50%;
    transform: translateX(-50%);
    border-radius: 50%;
  }

  /* Amélioration du focus visible */
  a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }
</style>
