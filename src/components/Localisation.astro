---
import siteConfigInfo from '../data/infoGeneral.json';
import Button from './ui/button.astro';

const infosPage = '../infos';
const googleMapsLink = siteConfigInfo.analytics.googleMapsLink;
---

<div
  class="border border-solid border-gray-300 rounded h-auto p-6 mb-12"
>
  <h2 class="strong text-foreground font-heading text-4xl mb-4">
    Localisation
  </h2>
  <p class="has-separator text-foreground-light uppercase">
    Une situation géographique idéale, dans les rues du centre bourg du
    Vaudreuil
  </p>
  <p class="text-foreground mb-7 mt-4.5 text-lg font-normal">
    Le village du Vaudreuil est situé à moins de 100 kilomètres de la région
    parisienne, à 20km de Rouen ou encore 120km de Caen par l’autoroute A13 ; un
    village normand doté d’un superbe golf de 18 trous.
  </p>

  <div>
    <Button variant="primary" href={infosPage} size="small">
      Infos pratiques
    </Button>
    {
      googleMapsLink && (
        <Button variant="primary" href={googleMapsLink} size="small">
          Obtenir un itinéraire
        </Button>
      )
    }
  </div>
</div>

<style>
  .has-separator {
    --separator-color: #76b201;
    --separator-size: 3px;
  }
</style>
