---
import '../styles/global.css';
import Social from './Social.astro';
import siteConfigInfo from '../data/infoGeneral.json';

const conditateUrl = siteConfigInfo.site.email.contact;
const phone = siteConfigInfo.phone.contact;
const formatedPhone = siteConfigInfo.phone.contact.replace(/\s+/g, '');
const address = siteConfigInfo.address;
const social = siteConfigInfo.social;
---

<div class="px-3 mb-11 box-border w-full">
  <h4 class="text-foreground-contrast text-base font-bold my-4">
    Association Fleurs & Jardins
  </h4>

  <div class="italic text-base text-foreground leading-7">
    {address && <p>{address}</p>}
    {
      phone && (
        <a class="underline" href={`tel:${formatedPhone}`}>
          Tél. {phone}
        </a>
      )
    }
  </div>

  <a
    class="block cursor-pointer underline hover:text-background-accent text-base text-foreground"
    href={`mailto:${conditateUrl}`}>Nous écrire</a
  >

  <h4 class="text-foreground-contrast text-base font-bold my-4">
    Retrouvez-nous également sur
  </h4>

  <ul class="flex items-center gap-4">
    {
      social.map(({ label, username }) => (
        <li>
          <Social platform={label} username={username} />
        </li>
      ))
    }
  </ul>
</div>
