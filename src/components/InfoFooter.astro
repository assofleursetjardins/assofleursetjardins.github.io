---
import '../styles/global.css';
import Social from './Social.astro';
import siteConfigInfo from '../data/infoGeneral.json';

const conditateUrl = siteConfigInfo.contact.email.general;
const phone = siteConfigInfo.contact.phone.general;
const formatedPhone = siteConfigInfo.contact.phone.general.replace(/\s+/g, '');
const address = siteConfigInfo.contact.address;
const social = siteConfigInfo.social.networks;
---

<div class="mb-11 box-border w-full space-y-8 px-3">
  <div>
    <h4 class="text-foreground-contrast my-4 text-base font-bold">
      Association Fleurs & Jardins
    </h4>

    <div class="text-foreground text-base leading-7 italic">
      {address && <p>{address}</p>}
      {
        phone && (
          <a class="underline" href={`tel:${formatedPhone}`}>
            Tél. {phone}
          </a>
        )
      }
    </div>

    <a
      class="hover:text-background-accent text-foreground block cursor-pointer text-base underline"
      href={`mailto:${conditateUrl}`}
    >
      Nous écrire
    </a>
  </div>

  <div>
    <h4 class="text-foreground-contrast my-4 text-base font-bold">
      Retrouvez-nous également sur
    </h4>

    <ul class="flex items-center gap-4">
      {
        social.map(({ label, url }) => (
          <li>
            <Social platform={label} url={url} />
          </li>
        ))
      }
    </ul>
  </div>
</div>
