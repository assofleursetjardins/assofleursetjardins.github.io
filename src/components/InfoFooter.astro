---
import '../styles/global.css';
import Social from './Social.astro';
import ExternalLink from './ExternalLink.astro';
import siteConfigInfo from '../data/infoGeneral.json';

const conditateUrl = siteConfigInfo.contact.email.general;
const phone = siteConfigInfo.contact.phone.general;
const formatedPhone = siteConfigInfo.contact.phone.general.replace(/\s+/g, '');
const address = siteConfigInfo.contact.address.postalAddress;
const addressLink = siteConfigInfo.contact.address.postalAddressLink;
const social = siteConfigInfo.social.networks;
---

<div class="mb-11 box-border w-full space-y-8 px-3">
  <div>
    <h4 class="text-foreground-contrast my-4 text-lg font-bold">
      Association Fleurs & Jardins
    </h4>

    <div class="text-foreground text-base leading-7 italic">
      {
        address && (
          <p>
            {address}
            {addressLink && (
              <>
                <span class="">-</span>
                <ExternalLink
                  href={addressLink}
                  aria-label="Voir sur Google Maps"
                  class="text-sm underline"
                >
                  Plan d'accès
                </ExternalLink>
              </>
            )}
          </p>
        )
      }
      {
        phone && (
          <a class="underline" href={`tel:${formatedPhone}`}>
            {phone}
          </a>
        )
      }
    </div>

    <a
      class="hover:text-background-accent text-foreground block cursor-pointer text-base underline"
      href={`mailto:${conditateUrl}`}
      aria-label={`Envoyer un email à ${conditateUrl}. Ouvre le client de messagerie par défaut.`}
    >
      Nous contacter par email
    </a>
  </div>

  <div>
    <h4 class="text-foreground-contrast my-4 text-lg font-bold">
      Retrouvez-nous également sur
    </h4>

    <ul
      class="flex items-center gap-4"
      aria-label="Réseaux sociaux"
      role="list"
    >
      {
        social.map(({ label, url }) => (
          <li role="listitem" class="flex items-center gap-2">
            <Social
              platform={label}
              url={url}
              aria-label={`Aller sur le réseau social ${label}.`}
            />
          </li>
        ))
      }
    </ul>
  </div>
</div>
