---
import siteConfigInfo from '../data/infoGeneral.json';
const { title, subtitle } = Astro.props;
---

<section class="mb-12 h-auto p-6">
  <hgroup>
    <h2 class="strong text-foreground font-heading mb-4 text-4xl">
      {title}
    </h2>
    <p class="has-separator text-foreground-light">
      {subtitle}
    </p>
  </hgroup>

  <div class="space-y-4">
    <slot />
  </div>

  <style>
    .has-separator {
      --separator-color: #76b201;
      --separator-size: 3px;
    }
  </style>
</section>
