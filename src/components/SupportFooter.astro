---
import { Image } from 'astro:assets';
import '../styles/global.css';

type LogoPartenairesType = {
  path: string;
  alt: string;
};

const LogoPartenaires: LogoPartenairesType[] = [
  { path: '/images/logo-le-vaudreuil.jpg', alt: 'logo-le-vaudreuil' },
  { path: '/images/logo-seine-eure.jpg', alt: 'logo-agglo-seine-eure' },
];
---

<div class="mb-11 box-border w-full px-3">
  <h4 class="text-foreground-contrast my-4 text-lg font-bold">
    Avec le soutien de :
  </h4>
  <div class="justify-left flex flex-wrap">
    {
      LogoPartenaires.map((item: LogoPartenairesType) => (
        <Image
          class="m-3.5 grayscale filter"
          src={item.path}
          width={100}
          height={100}
          alt={item.alt}
        />
      ))
    }
  </div>
</div>
