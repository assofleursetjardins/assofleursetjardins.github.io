---
const { id, isActive = false } = Astro.props;
---

<button
  id={id}
  class="cursor-pointer lg:hidden"
  aria-label="Ouvrir/fermer le menu principal"
>
  <span
    class="line line-1 mb-2 block h-[2px] w-8 bg-black transition-transform duration-300"
  ></span>
  <span
    class="line line-2 mb-2 block h-[2px] w-8 bg-black transition-opacity duration-300"
  ></span>
  <span
    class="line line-3 mb-2 block h-[2px] w-8 bg-black transition-transform duration-300"
  ></span>
</button>

<style>
  button[aria-expanded='true'] {
    .line-1 {
      transform: translateY(10px) rotate(45deg);
    }
    .line-2 {
      opacity: 0;
    }
    .line-3 {
      transform: translateY(-10px) rotate(-45deg);
    }
  }
</style>
