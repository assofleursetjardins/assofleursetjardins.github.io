---
import { cn, isExternalLink } from '../../lib/utils';

// Types
export type ButtonType = 'button' | 'a';

export type ButtonPropsType = {
  default?: string;
  variant?: 'default' | 'primary' | 'secondary';
  size?: 'small' | 'medium' | 'large';
  class?: string;
  href?: string;
};

// Récupération des props
const {
  variant = 'default',
  size = 'medium',
  class: className,
  href,
}: ButtonPropsType = Astro.props;

// Styles de base
const baseStyles =
  'justify-center inline-flex items-center gap-2 cursor-pointer font-base font-medium text-xl text-center no-underline select-none';

// Styles des variantes
const variants = {
  default: 'bg-foreground text-background hover:bg-foreground/90 rounded',
  primary: 'bg-primary text-foreground hover:bg-primary/90 rounded',
  secondary:
    'bg-secondary text-secondary-foreground hover:bg-secondary/90 rounded',
  outline:
    'border border-foreground text-foreground hover:bg-foreground/10 rounded',
  ghost:
    'border border-foreground/10 hover:bg-foreground/5 hover:text-foreground rounded',
  link: 'hover:underline px-0',
};

// Styles des tailles
const sizes = {
  small:
    'px-2.5 py-1.5 text-sm' /* dimensions pour les boutons de style default/verts*/,
  medium: 'px-5 py-2.5 text-base',
  large: 'px-6 py-3.5 text-lg',
  link: 'px-0 text-base',
};

// Définition du composant en fonction du type de lien
const Component: ButtonType = href ? 'a' : 'button';
const isExternal = href ? isExternalLink(href) : false;
---

<Component
  class={cn(baseStyles, variants[variant], sizes[size], className)}
  {href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noindex nofollow noopener noreferrer' : undefined}
>
  <slot />
  {
    isExternal && (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="var(--color-foreground-light)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="inline-block shrink-0"
        aria-hidden="true"
      >
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        <polyline points="15 3 21 3 21 9" />
        <line x1="10" y1="14" x2="21" y2="3" />
      </svg>
    )
  }
</Component>

<style>
  /* Amélioration du focus visible pour l'accessibilité */
  button:focus-visible,
  a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
</style>
