---
import { cn } from "../../lib/utils";

// Types
export type ButtonType = "button" | "a";

export type ButtonPropsType = {
  default?: string;
  variant?: "default" | "primary" | "secondary" | "white" | "outline";
  size?: "small" | "medium" | "large";
  class?: string;
  href?: string;
};

// Récupération des props
const {
  variant = "primary",
  size = "medium",
  class: className,
  href,
}: ButtonPropsType = Astro.props;

// Styles de base
const baseStyles = "cursor-pointer font-base text-xl block text-center w-full";

// Styles des variantes
const variants = {
  default: "bg-accent text-white hover:bg-hover-button mb-4", /*style pour les boutons verts*/
  primary: "bg-background text-background-inscription hover:bg-background/90", /*style pour le bouton dans composant inscription*/
  secondary: "",
  white: "bg-background text-foreground hover:bg-background/90", /*style pour le bouton blanc*/
  outline:
    "border border-gray-300 text-gray-700 hover:bg-gray-50 bg-transparent",
};

// Styles des tailles
const sizes = {
  small: "px-5 py-2.5", /* dimensions pour les boutons de style default/verts*/
  medium: "",
  large: "p-5",
};

// Définition du composant en fonction du type de lien
const Component: ButtonType = href ? "a": "button";
---

<Component class={cn(baseStyles, variants[variant], sizes[size], className)} {href}>
  <slot />
</Component>
