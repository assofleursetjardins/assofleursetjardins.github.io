---
import siteConfigInfo from '../data/infoGeneral.json';
const { title, subtitle } = Astro.props;
---

<div class="h-auto">
  <hgroup>
    <h2 class="strong text-foreground font-heading mb-0 text-4xl">
      {title}
    </h2>
    <p class="has-separator text-foreground-contrast">
      {subtitle}
    </p>
  </hgroup>

  <div class="space-y-4">
    <slot />
  </div>
</div>
