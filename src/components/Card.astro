---
import siteConfigInfo from '../data/infoGeneral.json';
const { title, subtitle } = Astro.props;
---

<section class="mb-12 h-auto p-6">
  <hgroup>
    <h2 class="strong text-foreground font-heading my-4 mb-0 text-4xl">
      {title}
    </h2>
    <p class="has-separator text-foreground-light">
      {subtitle}
    </p>
  </hgroup>

  <div class="space-y-4">
    <slot />
  </div>
</section>
