---
import data from '../data/exhibitors.json';

type ExhibitorType = {
  name: string;
  description: string;
  category: string;
};

const exhibitors = data.exhibitors;
const exhibitorsByCategory = exhibitors.reduce(
  (acc: Record<string, ExhibitorType[]>, exhibitor) => {
    acc[exhibitor.category] = acc[exhibitor.category] || [];
    acc[exhibitor.category].push(exhibitor);
    return acc;
  },
  {},
);
---

<section class="my-16 w-full">
  <h2 class="strong text-foreground font-heading mb-4 text-4xl uppercase">
    Nos fidèles exposants
  </h2>
  <div class="space-y-8">
    {
      Object.entries(exhibitorsByCategory).map(([category, exhibitors]) => (
        <div id={category.toLowerCase().replace(/\s+/g, '-')}>
          <h3 class="has-separator strong text-foreground font-heading text-2xl uppercase">
            {category}
          </h3>
          <ul class="text-foreground w-auto leading-7">
            {exhibitors.map((exhibitor: ExhibitorType) => (
              <li class="mr-[0.5em] inline">
                <span class="font-heading text-lg">{exhibitor.name}</span>{' '}
                <span class="text-xs uppercase">
                  {exhibitor.description}
                </span>{' '}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .has-separator {
    --separator-color: #a1acad;
    &::after {
      margin-top: 0.5rem !important;
    }
  }
</style>
