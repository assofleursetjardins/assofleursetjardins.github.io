---
import Layout from "../layouts/Layout.astro";
import Localisation from "../components/Localisation.astro";
const {
  metaTitle = "Exposants",
  metaDescription = "",
  pageTitle = "Exposants",
  pageDescription = "",
} = Astro.props;
---

<Layout title={metaTitle}>
  <header>
    <h1>{pageTitle}</h1>
    {pageDescription && <p>{pageDescription}</p>}
  </header>
  <Localisation />
</Layout>
