---
import Layout from "../layouts/Layout.astro";
import Tarifs from "../components/Tarifs.astro";
const {
    metaTitle = "",
    metaDescription = "",
    pageTitle = "À propos",
    pageDescription = "",
} = Astro.props;
---

<Layout title={metaTitle} />
<header>
    <h1>{pageTitle}</h1>
    {pageDescription && <p>{pageDescription}</p>}
    <Tarifs />
</header>
