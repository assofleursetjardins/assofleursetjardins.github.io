---
import Inscription from "../components/Inscription.astro";
import Layout from "../layouts/Layout.astro";
import Localisation from "../components/Localisation.astro";

import { content } from "../content/index.md";

const {
  metaTitle,
  metaDescription,
  title,
  description,
  image,
  layout,
  author,
  date,
} = content.frontmatter;
---

<Layout
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  pageTitle={title}
  pageDescription={description}
>
  <header>
    <h1>{title}</h1>
    {description && <p>{description}</p>}
  </header>

  <div>
    {content.body}
  </div>

  <Inscription />
  <Localisation />
</Layout>
