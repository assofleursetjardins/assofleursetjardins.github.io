---
import Inscription from "../components/Inscription.astro";
import Layout from "../layouts/Layout.astro";

const {
  metaTitle = "Page d'accueil",
  metaDescription = "",
  pageTitle = "Page d'accueil",
  pageDescription = "",
} = Astro.props;
---

<Layout title={metaTitle} />
<header>
  <h1>{pageTitle}</h1>
  {pageDescription && <p>{pageDescription}</p>}
</header>
<Inscription />
